  rag_entry_id    String? // link sang RagEntry náº¿u Ä‘Ã£ import
  created_at      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

// â”€â”€â”€ Conversation Analysis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 1:1 vá»›i Conversation, táº¡o sau khi conversation Ä‘Ã³ng
model ConversationAnalysis {
  id                   String   @id @default(uuid())
  conversation_id      String   @unique
  // Customer info extracted
  extracted_name       String?
  extracted_phone      String?
  extracted_address    String?
  extracted_house_type String?
  extracted_budget     BigInt?
