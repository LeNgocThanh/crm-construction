  // Pipeline status
  // Má»›i | Äang tÃ¬m hiá»ƒu | Háº¹n gáº·p | Äang thÆ°Æ¡ng tháº£o
  // Chá» kÃ½ HÄ | ÄÃ£ kÃ½ HÄ | Äang thi cÃ´ng
  // HoÃ n cÃ´ng | Báº£o hÃ nh | HoÃ n táº¥t | Táº¡m ngÆ°ng | Tá»« chá»‘i
  status String @default("Má»›i")

  // Nhu cáº§u xÃ¢y dá»±ng
  address    String?
  house_type String?
  floors     Int?
