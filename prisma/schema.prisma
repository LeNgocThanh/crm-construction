// Äá»‹nh nghÄ©a cÃ¡c cháº¿ Ä‘á»™ phÃ¢n tÃ­ch cÃ³ thá»ƒ báº­t/táº¯t/chá»‰nh sá»­a trong há»‡ thá»‘ng.
model AnalysisProfile {
  id              String   @id @default(uuid())
  key             String   @unique // crm_basic | estimate_v1 | ...
  name            String
  description     String?  @db.Text
  is_active       Boolean  @default(true)
  required_fields String[] @default([])
  output_schema   Json?
  prompt_template String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  runs AnalysisRun[]

  @@map("analysis_profiles")
}

// â€”â€” Analysis Runs â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”
// Má»—i láº§n phÃ¢n tÃ­ch (chat/audio/text) Ä‘Æ°á»£c lÆ°u thÃ nh 1 run Ä‘á»ƒ truy váº¿t vÃ  má»Ÿ rá»™ng Ä‘a-mode.
model AnalysisRun {
  id             String   @id @default(uuid())
  profile_key    String
  source_type    String // chat | audio | text | manual
  status         String   @default("completed") // completed | needs_data | failed
  input_text     String?  @db.Text
  summary        String?  @db.Text
  confidence     Float?
  missing_fields String[] @default([])
  result         Json?
  requested_by   String?

  customer_id     String?
  conversation_id String?
  contact_log_id  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile      AnalysisProfile @relation(fields: [profile_key], references: [key], onDelete: Restrict)
  customer     Customer?       @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  contact_log  ContactLog?     @relation(fields: [contact_log_id], references: [id], onDelete: SetNull)
  facts        AnalysisFact[]

  @@index([customer_id, created_at])
  @@index([profile_key, created_at])
  @@index([conversation_id])
  @@map("analysis_runs")
}

// â€”â€” Analysis Facts â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”
// Fact-level store: trung tÃ¢m Ä‘á»ƒ tÃ¡i sá»­ dá»¥ng cho CRM, khÃ¡i toÃ¡n, hoáº·c cÃ¡c mode phÃ¢n tÃ­ch khÃ¡c.
model AnalysisFact {
  id              String   @id @default(uuid())
  run_id          String
  customer_id     String?
  fact_key        String
  fact_value      Json
  normalized_text String?
  unit            String?
  confidence      Float?
  source_type     String? // chat | audio | text
  source_ref_id   String? // message_id | contact_log_id | ...
  is_confirmed    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  run      AnalysisRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@index([customer_id, fact_key, created_at])
  @@index([run_id, fact_key])
  @@map("analysis_facts")
}

// â€”â€” Estimation Knowledge Base â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”
// Nguá»“n tri thá»©c khÃ¡i toÃ¡n: giÃ¡ váº­t tÆ° + recipe tá»· lá»‡ theo loáº¡i nhÃ /phong cÃ¡ch.
model EstimationMaterialPrice {
  id             String    @id @default(uuid())
  material_key   String // cat | gach | xi_mang | thep | ...
  material_name  String
  unit           String // kg | m3 | vien | tan | ...
  price_per_unit BigInt
  region_code    String? // HCM | HN | ALL | ...
  source_note    String?   @db.Text
  valid_from     DateTime  @default(now())
  valid_to       DateTime?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([material_key, region_code, valid_from])
  @@map("estimation_material_prices")
}

model EstimationTaxonomy {
  id          String   @id @default(uuid())
  kind        String // house_type | style | level
  value       String // machine key: nha_ong, hien_dai, premium...
  name        String // tÃƒÂªn hiÃ¡Â»Æ’n thÃ¡Â»â€¹
  description String?  @db.Text
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, is_active, sort_order])
  @@map("estimation_taxonomies")
}

model EstimationCoefficientConfig {
  id                           String   @id @default("default")
  floors_threshold             Int      @default(3)
  floors_coeff_per_extra       Float    @default(0.02)
  tum_coeff                    Float    @default(0.03)
  basement_coeff               Float    @default(0.08)
  elevator_coeff               Float    @default(0.06)
  finish_co_ban_multiplier     Float    @default(1.0)
  finish_tieu_chuan_multiplier Float    @default(1.08)
  finish_cao_cap_multiplier    Float    @default(1.18)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  @@map("estimation_coefficient_configs")
}

model EstimationRecipe {
  id          String   @id @default(uuid())
  recipe_key  String   @unique // nha_co_dien_loai_1 | nha_pho_tieu_chuan | ...
  recipe_name String
  house_type  String? // Nha pho | Biet thu | Nha cap 4 | ...
  style       String? // co_dien | hien_dai | ...
  level       String? // loai_1 | loai_2 | ...
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  items  EstimationRecipeItem[]
  quotes EstimationQuote[]

  @@index([house_type, style, level])
  @@map("estimation_recipes")
}

model EstimationRecipeItem {
  id              String   @id @default(uuid())
  recipe_id       String
  material_key    String
  material_name   String?
  ratio_percent   Float? // VÃ­ dá»¥ cÃ¡t 12% trong nhÃ³m VL chÃ­nh
  quantity_per_m2 Float? // Hoáº·c Ä‘á»‹nh má»©c theo m2
  waste_factor    Float? // Há»‡ sá»‘ hao há»¥t (vd 0.03 = 3%)
  note            String?  @db.Text
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  recipe EstimationRecipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@unique([recipe_id, material_key])
  @@index([recipe_id, sort_order])
  @@map("estimation_recipe_items")
}

model EstimationQuote {
  id               String   @id @default(uuid())
  customer_id      String?
  recipe_id        String?
  recipe_key       String?
  recipe_name      String?
  region_code      String?
  quote_date       DateTime @default(now())
  floor_area_total Float?
  floors           Int?
  tum_count        Int?
  basement_count   Int?
  has_elevator     Boolean?
  finish_level     String?
  base_cost_per_m2 BigInt?
  coeff_total      Float?
  subtotal_cost    BigInt?
  total_cost       BigInt
  pricing_mode     String? // regional_price | base_x_coef | mixed
  status           String   @default("draft") // draft | sent | adjusted | approved_as_correct
  extra_facts_json Json?
  input_snapshot   Json?
  result_snapshot  Json?
  created_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  customer      Customer?                  @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  recipe        EstimationRecipe?          @relation(fields: [recipe_id], references: [id], onDelete: SetNull)
  items         EstimationQuoteItem[]
  dispatches    CustomerEstimateDispatch[]
  project_links ProjectEstimateLink[]

  @@index([customer_id, created_at])
  @@index([status, created_at])
  @@map("estimation_quotes")
}

model EstimationQuoteItem {
  id            String   @id @default(uuid())
  quote_id      String
  material_key  String
  material_name String?
  unit          String?
  quantity      Float?
  unit_price    BigInt?
  ratio_percent Float?
  cost          BigInt
  price_source  String? // exact_region | region_fallback | base_ratio
  note          String?  @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  quote EstimationQuote @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id])
  @@map("estimation_quote_items")
}

// --- Estimate V2: Open knowledge base (catalog/template/rule) ---
model EstimationCatalogItem {
  id          String   @id @default(uuid())
  item_code   String   @unique
  item_name   String
  item_type   String // material | labor | equipment | fixture | service
  item_group  String // ket_cau | xay_to | hoan_thien | mep_dien | mep_nuoc | noi_that | khac
  item_unit   String
  specs       Json?
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  template_items                  EstimationTemplateItem[]
  supplier_prices                 SupplierMaterialPrice[]
  warehouse_stocks                WarehouseStock[]
  inventory_items                 InventoryTransactionItem[]
  inventory_price_logs            InventoryMaterialPriceLog[]
  inventory_stock_audit_items     InventoryStockAuditItem[]
  purchase_request_items          InventoryPurchaseRequestItem[]
  purchase_order_items            InventoryPurchaseOrderItem[]
  project_direct_purchase_items   ProjectDirectPurchaseItem[]
  project_material_ledger_entries ProjectMaterialLedger[]

  @@index([item_type, item_group, is_active])
  @@map("estimation_catalog_items")
}

// Nha cung cap vat tu/dich vu dung chung cho du toan + kho
model Supplier {
  id            String   @id @default(uuid())
  supplier_code String   @unique
  supplier_name String
  contact_name  String?
  phone         String? // deprecated: se move sang SupplierProfile.primary_phone
  email         String?
  address       String?
  region_code   String?
  note          String?  @db.Text
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  prices                          SupplierMaterialPrice[]
  inventory_price_logs            InventoryMaterialPriceLog[]
  txns                            InventoryTransaction[]
  stocks                          WarehouseStock[]
  purchase_requests               InventoryPurchaseRequest[]
  purchase_orders                 InventoryPurchaseOrder[]
  project_direct_purchases        ProjectDirectPurchase[]
  project_material_ledger_entries ProjectMaterialLedger[]
  subcontracted_resource_plans    ProjectResourcePlan[]      @relation("ProjectPlanSubcontractor")
  subcontracted_site_issues       ProjectSiteIssue[]         @relation("ProjectSiteIssueSubcontractor")
  profile                         SupplierProfile?

  @@index([is_active, supplier_name])
  @@index([region_code, is_active])
  @@map("suppliers")
}

// Ho so nghiep vu mo rong cua nha cung cap (1-1)
model SupplierProfile {
  id                  String    @id @default(uuid())
  supplier_id         String    @unique
  supplier_type       String? // company | store | individual | distributor | factory | contractor | service
  legal_name          String?
  tax_code            String?
  business_license_no String?
  primary_phone       String?
  secondary_phone     String?
  zalo_phone          String?
  contact_email       String?
  payment_terms_days  Int?      @default(0)
  credit_limit        BigInt? // han muc cong no
  current_debt        BigInt?   @default(0)
  debt_updated_at     DateTime?
  note                String?   @db.Text
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@index([supplier_type])
  @@index([primary_phone])
  @@map("supplier_profiles")
}

// Bang gia theo nha cung cap (co hieu luc theo thoi gian)
model SupplierMaterialPrice {
  id              String    @id @default(uuid())
  supplier_id     String
  catalog_item_id String?
  material_key    String
  material_name   String?
  unit            String?
  region_code     String?
  price_per_unit  BigInt
  currency        String    @default("VND")
  min_order_qty   Float?
  source_note     String?   @db.Text
  valid_from      DateTime  @default(now())
  valid_to        DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  supplier     Supplier               @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  catalog_item EstimationCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)

  @@index([material_key, region_code, valid_from])
  @@index([supplier_id, material_key, valid_from])
  @@index([catalog_item_id, valid_from])
  @@map("supplier_material_prices")
}

// Kho vat tu
model Warehouse {
  id             String   @id @default(uuid())
  warehouse_code String   @unique
  warehouse_name String
  region_code    String?
  address        String?
  manager_name   String?
  manager_phone  String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  stocks WarehouseStock[]
  txns   InventoryTransaction[]
  stock_audits InventoryStockAudit[]
  purchase_requests InventoryPurchaseRequest[]
  purchase_orders InventoryPurchaseOrder[]
  inventory_price_logs InventoryMaterialPriceLog[]
  inventory_cost_cycles InventoryCostCycle[]

  @@index([is_active, warehouse_name])
  @@index([region_code, is_active])
  @@map("warehouses")
}

// Ton kho hien tai theo tung item trong moi kho
model WarehouseStock {
  id              String    @id @default(uuid())
  warehouse_id    String
  catalog_item_id String?
  material_key    String
  material_name   String?
  item_unit       String?
  supplier_id     String?
  on_hand_qty     Float     @default(0)
  reserved_qty    Float     @default(0)
  avg_unit_cost   BigInt? // gia von binh quan hien tai
  stock_value     BigInt? // gia tri ton kho = on_hand * avg (VND)
  min_qty         Float?
  max_qty         Float?
  last_in_at      DateTime?
  last_out_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  warehouse    Warehouse              @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  catalog_item EstimationCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)
  supplier     Supplier?              @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  cost_cycles  InventoryCostCycle[]
  stock_audit_items InventoryStockAuditItem[]

  @@unique([warehouse_id, material_key])
  @@index([warehouse_id, on_hand_qty])
  @@index([supplier_id, warehouse_id])
  @@map("warehouse_stocks")
}

// Phieu xuat/nhap/dieu chinh kho
model InventoryTransaction {
  id             String   @id @default(uuid())
  txn_code       String   @unique
  warehouse_id   String
  txn_type       String // in | out | adjust | transfer_in | transfer_out
  issue_purpose  String? // project_supply | crew_supply | maintenance_supply | loss_damage | internal_use | other
  txn_date       DateTime @default(now())
  supplier_id    String?
  reference_type String? // estimate_quote | purchase_order | manual | transfer | stock_audit
  reference_id   String?
  status         String   @default("posted") // draft | posted | canceled
  note           String?  @db.Text
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  warehouse Warehouse                  @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  supplier  Supplier?                  @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  items     InventoryTransactionItem[]
  applied_stock_audits InventoryStockAudit[] @relation("InventoryStockAuditAppliedTxn")
  price_logs InventoryMaterialPriceLog[]

  @@index([warehouse_id, txn_date])
  @@index([supplier_id, txn_date])
  @@index([reference_type, reference_id])
  @@map("inventory_transactions")
}

model InventoryTransactionItem {
  id              String   @id @default(uuid())
  txn_id          String
  catalog_item_id String?
  material_key    String
  material_name   String?
  item_unit       String?
  quantity        Float
  unit_price      BigInt?
  line_total      BigInt?
  note            String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  txn          InventoryTransaction   @relation(fields: [txn_id], references: [id], onDelete: Cascade)
  catalog_item EstimationCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)
  price_logs    InventoryMaterialPriceLog[]

  @@index([txn_id])
  @@index([material_key])
  @@map("inventory_transaction_items")
}

model InventoryPurchaseRequest {
  id               String   @id @default(uuid())
  request_code     String   @unique
  warehouse_id     String
  supplier_id      String?
  request_date     DateTime @default(now())
  needed_date      DateTime?
  status           String   @default("draft") // draft | submitted | approved | rejected | cancelled | ordered
  note             String?  @db.Text
  created_by       String?
  approved_by      String?
  approved_at      DateTime?
  rejected_by      String?
  rejected_at      DateTime?
  cancelled_by     String?
  cancelled_at     DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  warehouse       Warehouse                 @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  supplier        Supplier?                 @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  items           InventoryPurchaseRequestItem[]
  purchase_orders InventoryPurchaseOrder[]

  @@index([warehouse_id, request_date])
  @@index([supplier_id, request_date])
  @@index([status, request_date])
  @@map("inventory_purchase_requests")
}

model InventoryPurchaseRequestItem {
  id                   String   @id @default(uuid())
  request_id           String
  catalog_item_id      String?
  material_key         String
  material_name        String?
  item_unit            String?
  quantity             Float
  suggested_unit_price BigInt?
  note                 String?  @db.Text
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  request      InventoryPurchaseRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  catalog_item EstimationCatalogItem?   @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)
  order_items   InventoryPurchaseOrderItem[]

  @@index([request_id])
  @@index([material_key])
  @@map("inventory_purchase_request_items")
}

model InventoryPurchaseOrder {
  id             String   @id @default(uuid())
  order_code     String   @unique
  request_id     String?
  warehouse_id   String
  supplier_id    String
  order_date     DateTime @default(now())
  expected_date  DateTime?
  status         String   @default("draft") // draft | confirmed | partial_received | completed | cancelled
  note           String?  @db.Text
  created_by     String?
  confirmed_by   String?
  confirmed_at   DateTime?
  cancelled_by   String?
  cancelled_at   DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  request   InventoryPurchaseRequest? @relation(fields: [request_id], references: [id], onDelete: SetNull)
  warehouse Warehouse                 @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  supplier  Supplier                  @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items     InventoryPurchaseOrderItem[]

  @@index([request_id, order_date])
  @@index([warehouse_id, order_date])
  @@index([supplier_id, order_date])
  @@index([status, order_date])
  @@map("inventory_purchase_orders")
}

model InventoryPurchaseOrderItem {
  id                String   @id @default(uuid())
  order_id          String
  request_item_id   String?
  catalog_item_id   String?
  material_key      String
  material_name     String?
  item_unit         String?
  ordered_qty       Float
  received_qty      Float    @default(0)
  draft_receipt_qty Float    @default(0)
  unit_price        BigInt?
  note              String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  order        InventoryPurchaseOrder       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  request_item InventoryPurchaseRequestItem? @relation(fields: [request_item_id], references: [id], onDelete: SetNull)
  catalog_item EstimationCatalogItem?       @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([material_key])
  @@map("inventory_purchase_order_items")
}

model InventoryStockAudit {
  id                String   @id @default(uuid())
  audit_code        String   @unique
  warehouse_id      String
  audit_date        DateTime @default(now())
  status            String   @default("draft") // draft | counted | applied | cancelled
  note              String?  @db.Text
  total_items       Int      @default(0)
  counted_items     Int      @default(0)
  variance_items    Int      @default(0)
  total_variance_value BigInt? @default(0)
  applied_txn_id    String?
  created_by        String?
  counted_by        String?
  counted_at        DateTime?
  applied_by        String?
  applied_at        DateTime?
  cancelled_by      String?
  cancelled_at      DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  applied_txn InventoryTransaction? @relation("InventoryStockAuditAppliedTxn", fields: [applied_txn_id], references: [id], onDelete: SetNull)
  items     InventoryStockAuditItem[]

  @@index([warehouse_id, audit_date])
  @@index([status, audit_date])
  @@map("inventory_stock_audits")
}

model InventoryStockAuditItem {
  id                String   @id @default(uuid())
  audit_id          String
  stock_id          String?
  catalog_item_id   String?
  material_key      String
  material_name     String?
  item_unit         String?
  book_qty          Float    @default(0)
  counted_qty       Float?
  variance_qty      Float?
  avg_unit_cost     BigInt?
  variance_value    BigInt?
  note              String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  audit       InventoryStockAudit    @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  stock       WarehouseStock?        @relation(fields: [stock_id], references: [id], onDelete: SetNull)
  catalog_item EstimationCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)

  @@index([audit_id])
  @@index([stock_id])
  @@index([material_key])
  @@map("inventory_stock_audit_items")
}

// Lich su gia thuc te cua vat tu theo phat sinh mua/nhap
model InventoryMaterialPriceLog {
  id              String   @id @default(uuid())
  warehouse_id    String?
  supplier_id     String?
  txn_id          String?
  txn_item_id     String?
  catalog_item_id String?
  material_key    String
  material_name   String?
  item_unit       String?
  price_kind      String   @default("inventory_in") // supplier_quote | inventory_in | transfer_in | direct_purchase | manual
  unit_price      BigInt
  quantity        Float?
  line_total      BigInt?
  cycle_no        Int?
  effective_at    DateTime @default(now())
  source_note     String?  @db.Text
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  warehouse    Warehouse?              @relation(fields: [warehouse_id], references: [id], onDelete: SetNull)
  supplier     Supplier?               @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  txn          InventoryTransaction?   @relation(fields: [txn_id], references: [id], onDelete: SetNull)
  txn_item     InventoryTransactionItem? @relation(fields: [txn_item_id], references: [id], onDelete: SetNull)
  catalog_item EstimationCatalogItem?  @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)

  @@index([material_key, effective_at])
  @@index([supplier_id, material_key, effective_at])
  @@index([warehouse_id, material_key, effective_at])
  @@index([txn_id])
  @@map("inventory_material_price_logs")
}

// Vong gia ton cua tung vat tu trong tung kho
model InventoryCostCycle {
  id                 String    @id @default(uuid())
  warehouse_id       String
  stock_id           String?
  material_key       String
  cycle_no           Int
  started_at         DateTime  @default(now())
  ended_at           DateTime?
  opening_qty        Float     @default(0)
  opening_value      BigInt?   @default(0)
  opening_avg_cost   BigInt?   @default(0)
  closing_qty        Float?
  closing_value      BigInt?
  closing_avg_cost   BigInt?
  last_in_at         DateTime?
  last_out_at        DateTime?
  last_price_log_id  String?
  reset_reason       String?   // clear_stock | manual_reset | inventory_adjust | negative_to_zero
  source_txn_id      String?
  source_note        String?   @db.Text
  is_open            Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  warehouse Warehouse      @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  stock     WarehouseStock? @relation(fields: [stock_id], references: [id], onDelete: SetNull)

  @@unique([warehouse_id, material_key, cycle_no])
  @@index([warehouse_id, material_key, is_open])
  @@index([material_key, started_at])
  @@map("inventory_cost_cycles")
}

model PrintBrandConfig {
  id               String   @id
  brand_name       String
  legal_name       String
  tagline          String?
  logo_url         String?
  accent_color     String?  @default("#ea580c")
  accent_soft      String?  @default("#fff7ed")
  border_color     String?  @default("#cbd5e1")
  address          String?  @db.Text
  phone            String?
  email            String?
  tax_code         String?
  footer_text      String?  @db.Text
  updated_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("print_brand_configs")
}

model SalesBriefHeatConfig {
  id            String   @id @default(uuid())
  config_key    String   @unique
  config_name   String
  group_name    String
  value_type    String   @default("number") // number | percent
  config_value  String
  description   String?  @db.Text
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  is_locked     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([group_name, sort_order])
  @@index([is_active, sort_order])
  @@map("sales_brief_heat_configs")
}

model ProjectDirectPurchase {
  id            String    @id @default(uuid())
  project_id    String
  plan_id       String?
  purchase_code String    @unique
  purchase_date DateTime  @default(now())
  supplier_id   String?
  supplier_name String?
  status        String    @default("draft") // draft | confirmed | cancelled
  note          String?   @db.Text
  created_by    String?
  confirmed_by  String?
  confirmed_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  project   ConstructionProject         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  plan      ProjectResourcePlan?        @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  supplier  Supplier?                   @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  creator   User?                       @relation("ProjectDirectPurchaseCreator", fields: [created_by], references: [id], onDelete: SetNull)
  confirmer User?                       @relation("ProjectDirectPurchaseConfirmer", fields: [confirmed_by], references: [id], onDelete: SetNull)
  items     ProjectDirectPurchaseItem[]

  @@index([project_id, purchase_date])
  @@index([project_id, status, created_at])
  @@index([project_id, plan_id, status, purchase_date])
  @@index([supplier_id, purchase_date])
  @@map("project_direct_purchases")
}

model ProjectDirectPurchaseItem {
  id              String   @id @default(uuid())
  purchase_id     String
  project_id      String
  catalog_item_id String?
  material_key    String
  material_name   String?
  item_unit       String?
  quantity        Float
  unit_price      BigInt?
  line_total      BigInt?
  note            String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  purchase     ProjectDirectPurchase  @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  project      ConstructionProject    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  catalog_item EstimationCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)

  @@index([purchase_id])
  @@index([project_id, material_key])
  @@map("project_direct_purchase_items")
}

model ProjectMaterialLedger {
  id              String   @id @default(uuid())
  project_id      String
  direction       String // in | out | consume | return | adjust
  source_type     String // inventory_txn | direct_purchase | diary | manual
  source_id       String?
  supplier_id     String?
  catalog_item_id String?
  material_key    String
  material_name   String?
  item_unit       String?
  quantity        Float
  unit_price      BigInt?
  line_total      BigInt?
  note            String?  @db.Text
  happened_at     DateTime @default(now())
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  project      ConstructionProject    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  supplier     Supplier?              @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  catalog_item EstimationCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)
  creator      User?                  @relation("ProjectMaterialLedgerCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([project_id, happened_at])
  @@index([project_id, material_key, happened_at])
  @@index([source_type, source_id])
  @@index([supplier_id, happened_at])
  @@map("project_material_ledger")
}

model EstimationTemplateHeader {
  id             String    @id @default(uuid())
  template_code  String
  template_name  String
  template_type  String // room | wc | house | structure | mep | custom
  house_type     String?
  style          String?
  finish_level   String?
  room_type      String?
  priority       Int       @default(0)
  version        Int       @default(1)
  is_active      Boolean   @default(true)
  effective_from DateTime?
  effective_to   DateTime?
  description    String?   @db.Text
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  items                  EstimationTemplateItem[]
  assembly_blocks        ProjectAssemblyBlock[]
  assembly_preset_blocks ProjectAssemblyPresetBlock[]

  @@unique([template_code, version])
  @@index([template_type, is_active, priority])
  @@index([house_type, style, finish_level])
  @@map("estimation_template_headers")
}

model EstimationTemplateItem {
  id                 String    @id @default(uuid())
  template_id        String
  catalog_item_id    String
  apply_mode         String // per_area | per_unit | fixed | formula (legacy: per_m2 | per_room)
  quantity_basis_key String? // floor_area_total | main_floor_area_total | wall_surface_area_total | room_count | ...
  scope_key          String? // bedroom | wc | kitchen | living_room | cau_thang | mong_coc | ...
  quantity_value     Float?
  formula_expr       String?   @db.Text
  required_facts     Json?
  formula_version    Int       @default(1)
  formula_note       String?   @db.Text
  waste_factor       Float?
  sort_order         Int       @default(0)
  is_active          Boolean   @default(true)
  effective_from     DateTime?
  effective_to       DateTime?
  note               String?   @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  template     EstimationTemplateHeader @relation(fields: [template_id], references: [id], onDelete: Cascade)
  catalog_item EstimationCatalogItem    @relation(fields: [catalog_item_id], references: [id], onDelete: Restrict)

  @@unique([template_id, catalog_item_id, sort_order])
  @@index([template_id, is_active, sort_order])
  @@index([catalog_item_id])
  @@map("estimation_template_items")
}

model EstimationRuleHeader {
  id             String    @id @default(uuid())
  rule_code      String
  rule_name      String
  scope          String // foundation | structure | room | mep | pricing | custom
  priority       Int       @default(0)
  version        Int       @default(1)
  is_active      Boolean   @default(true)
  effective_from DateTime?
  effective_to   DateTime?
  description    String?   @db.Text
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  conditions EstimationRuleCondition[]
  actions    EstimationRuleAction[]

  @@unique([rule_code, version])
  @@index([scope, is_active, priority])
  @@map("estimation_rule_headers")
}

model EstimationRuleCondition {
  id           String   @id @default(uuid())
  rule_id      String
  fact_key     String // floors | house_type | foundation_type | room_count | ...
  operator     String // eq | neq | gt | gte | lt | lte | in | between
  value_text   String?
  value_number Float?
  value_json   Json?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  rule EstimationRuleHeader @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id, sort_order])
  @@map("estimation_rule_conditions")
}

model EstimationRuleAction {
  id           String   @id @default(uuid())
  rule_id      String
  action_type  String // set_field | add_item | multiply_coeff | suggest_value | add_warning
  target_key   String? // foundation_type | pile_spacing | item_code | coeff_total | ...
  value_text   String?
  value_number Float?
  value_json   Json?
  formula_expr String?  @db.Text
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  rule EstimationRuleHeader @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id, sort_order])
  @@map("estimation_rule_actions")
}

// Danh muc don vi hanh chinh Viet Nam (seed tu thanglequoc/vietnamese-provinces-database)
model GeoRegion {
  id             String   @id @default(uuid())
  code           String // ma DVHC (vd: 01, 00004, ...)
  name           String // ten day du (vd: Thanh pho Ha Noi, Phuong Ba Dinh)
  level          String // province | ward
  parent_code    String? // ward -> province_code
  source         String   @default("thanglequoc/vietnamese-provinces-database")
  source_version String? // master / tag / release ref
  latitude       Float?
  longitude      Float?
  meta_json      Json?
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([level, code])
  @@index([level, is_active, sort_order])
  @@index([parent_code, level])
  @@map("geo_regions")
}
