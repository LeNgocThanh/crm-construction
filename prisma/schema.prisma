// â”€â”€â”€ Contact Logs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ContactLog {
  id                String   @id @default(uuid())
  customer_id       String
  sales_id          String
  contact_date      DateTime @default(now())
  audio_file_path   String?
  transcription_raw String?  @db.Text
  ai_summary        String?  @db.Text
  ai_sentiment      String? // TÃ­ch cá»±c | Trung láº­p | Gay gáº¯t
  next_action       String?  @db.Text
  notes             String?  @db.Text
  // Nguá»“n â€” call hoáº·c chat
  source            String   @default("call") // call | telegram | zalo | messenger
  conversation_id   String? // link sang Conversation náº¿u source = chat

  // BÃ³c tÃ¡ch AI per-log
  ext_full_name  String?
  ext_address    String?
  ext_house_type String?
  ext_floors     Int?
  ext_floor_area Float?
  ext_budget     BigInt?
  ext_notes      String? @db.Text

  // Tiá»m nÄƒng (tá»« AI phÃ¢n tÃ­ch)
  potential_score Int?
  potential_level String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer      Customer      @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  sales         User          @relation(fields: [sales_id], references: [id])
  conversation  Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  analysis_runs AnalysisRun[]

  @@map("contact_logs")
}

// â”€â”€â”€ Construction Projects â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ConstructionProject {
  id                       String    @id @default(uuid())
  customer_id              String
  // â”€â”€ ThÃ´ng tin bÃ³c tÃ¡ch / ká»¹ thuáº­t â”€â”€
  address                  String?
  house_type               String? // NhÃ  phá»‘ | Biá»‡t thá»± | NhÃ  cáº¥p 4 | Chung cÆ° | KhÃ¡c
  floors                   Int?
  floor_area               Float?
  estimated_budget         BigInt? // NgÃ¢n sÃ¡ch Æ°á»›c tÃ­nh tá»« bÃ³c tÃ¡ch
  notes                    String?   @db.Text
  // â”€â”€ Tráº¡ng thÃ¡i dá»± Ã¡n â”€â”€
  status                   String    @default("draft")
  // draft: tá»•ng há»£p tá»« bÃ³c tÃ¡ch, chÆ°a chá»‘t
  // confirmed: Ä‘Ã£ chá»‘t, dá»± Ã¡n chÃ­nh thá»©c
  // in_progress: Ä‘ang thi cÃ´ng
  // completed: hoÃ n thÃ nh
  // paused: táº¡m ngÆ°ng
  // cancelled: há»§y
  stage                    String?
  // thiáº¿t_káº¿ | xin_phÃ©p | mÃ³ng | thÃ´ | hoÃ n_thiá»‡n | bÃ n_giao
  // â”€â”€ ThÃ´ng tin há»£p Ä‘á»“ng (chá»‰ cÃ³ khi confirmed) â”€â”€
  contract_value           BigInt? // GiÃ¡ trá»‹ há»£p Ä‘á»“ng thá»±c táº¿
  budget_baseline          BigInt? // ngan sach goc
  budget_current           BigInt? // ngan sach dieu chinh hien tai
  budget_allocated         BigInt? // ngan sach da phan bo
  cost_committed           BigInt? // da cam ket mua/dat
  cost_actual              BigInt? // chi phi phat sinh thuc
  cash_on_hand             BigInt? // so du tien hien co cho du an
  receivable_planned_30d   BigInt? // du kien thu 30 ngay
  payable_planned_30d      BigInt? // du kien chi 30 ngay
  progress_planned_percent Float? // % ke hoach hien tai
  progress_actual_percent  Float? // % thuc te hien tai
  delay_days               Int? // so ngay tre (co the tinh tu milestone)
  risk_level               String? // low | medium | high | critical
  start_date               DateTime?
  expected_end_date        DateTime?
  actual_end_date          DateTime?
  confirmed_at             DateTime?
  confirmed_by             String? // user_id
  owner_id                 String?
  default_owner_id         String?
  active_material_plan_id  String?
  active_labor_plan_id     String?
  // â”€â”€ TÃªn dá»± Ã¡n â”€â”€
  project_name             String? // TÃªn hiá»ƒn thá»‹, máº·c Ä‘á»‹nh = "NhÃ  [tÃªn KH]"
  // â”€â”€ Nguá»“n dá»¯ liá»‡u â”€â”€
  source                   String    @default("manual")
  // manual | ai_extraction | ai_merge
  extraction_quality       Int? // 0-100, Ä‘á»™ tin cáº­y dá»¯ liá»‡u bÃ³c tÃ¡ch
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  customer                Customer                     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  confirmer               User?                        @relation("ProjectConfirmer", fields: [confirmed_by], references: [id], onDelete: SetNull)
  owner                   User?                        @relation("ProjectOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  default_owner           User?                        @relation("ProjectDefaultOwner", fields: [default_owner_id], references: [id], onDelete: SetNull)
  active_material_plan    ProjectResourcePlan?         @relation("ProjectActiveMaterialPlan", fields: [active_material_plan_id], references: [id], onDelete: SetNull)
  active_labor_plan       ProjectResourcePlan?         @relation("ProjectActiveLaborPlan", fields: [active_labor_plan_id], references: [id], onDelete: SetNull)
  requirement_snapshots   ProjectRequirementSnapshot[] @relation("RequirementSnapshotConvertedProject")
  documents               ProjectDocument[]
  milestones              ProjectMilestone[]
  estimate_links          ProjectEstimateLink[]
  payment_plans           ProjectPaymentPlan[]
  payments                ProjectPayment[]
  timeline_events         ProjectTimelineEvent[]
  diary_entries           ProjectDiaryEntry[]
  site_issues             ProjectSiteIssue[]
  resource_plans          ProjectResourcePlan[]
  resource_items          ProjectResourcePlanItem[]
  cashflow_snapshots      ProjectCashflowSnapshot[]
  direct_purchases        ProjectDirectPurchase[]
  material_allocations    ProjectMaterialAllocation[]
  direct_purchase_items   ProjectDirectPurchaseItem[]
  material_ledger_entries ProjectMaterialLedger[]
  labor_engagements       ProjectLaborEngagement[]
  labor_attendances       ProjectLaborAttendance[]
  labor_roster_entries    ProjectLaborRoster[]
  labor_payment_batches   ProjectLaborPaymentBatch[]
  labor_payments          ProjectLaborPayment[]
  assets                  Asset[]                      @relation("AssetCurrentProject")
  asset_assignments       AssetAssignment[]

  @@map("construction_projects")
}

model ProjectCashflowSnapshot {
  id                       String   @id @default(uuid())
  project_id               String
  snapshot_date            DateTime @default(now())
  snapshot_type            String   @default("month_end") // month_end | event | milestone
  period_key               String? // YYYY-MM when month_end
  milestone_id             String?
  budget_current           BigInt?
  budget_allocated         BigInt?
  cost_committed           BigInt?
  cost_actual              BigInt?
  cash_on_hand             BigInt?
  receivable_planned_30d   BigInt?
  payable_planned_30d      BigInt?
  progress_planned_percent Float?
  progress_actual_percent  Float?
  delay_days               Int?
  risk_level               String?
  demand_30d               BigInt?
  supply_30d               BigInt?
  gap_30d                  BigInt?
  warning_level            String?
  note                     String?  @db.Text
  metadata_json            Json?
  created_by               String?
  created_at               DateTime @default(now())

  project   ConstructionProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestone ProjectMilestone?   @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  creator   User?               @relation("ProjectCashflowSnapshotCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([project_id, snapshot_date])
  @@index([project_id, snapshot_type, period_key])
  @@index([milestone_id])
  @@map("project_cashflow_snapshots")
}

model ProjectDiaryEntry {
  id                     String   @id @default(uuid())
  project_id             String
  entry_date             DateTime
  shift_type             String? // morning | afternoon | full_day | night
  title                  String
  summary                String?  @db.Text
  manpower_summary       String?  @db.Text
  equipment_summary      String?  @db.Text
