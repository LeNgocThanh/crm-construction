// â”€â”€â”€ Conversations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Má»—i conversation = 1 thread vá»›i 1 ngÆ°á»i dÃ¹ng trÃªn 1 channel
model Conversation {
  id                String    @id @default(uuid())
  channel           String // zalo | messenger | telegram
  external_conv_id  String // ID tá»« Zalo/Meta
  external_user_id  String // Zalo user_id / PSID
  display_name      String?
  avatar_url        String?
  // Customer link (null cho Ä‘áº¿n khi match/extract Ä‘Æ°á»£c SÄT)
  customer_id       String?
  // State
  status            String    @default("active") // active | closed | pending_callback
  bot_mode          String    @default("auto") // auto | manual | takeover
  close_reason      String? // timeout | callback_requested | sales_closed | resolved
  // Tracking
  last_message_at   DateTime  @default(now())
  opened_at         DateTime  @default(now())
  closed_at         DateTime?
  // Flags
  has_contact_info  Boolean   @default(false) // Ä‘Ã£ láº¥y Ä‘Æ°á»£c SÄT/tÃªn
  has_address       Boolean   @default(false) // Ä‘Ã£ láº¥y Ä‘Æ°á»£c Ä‘á»‹a chá»‰
  meeting_requested Boolean   @default(false) // bot Ä‘Ã£ má»i háº¹n
  meeting_confirmed Boolean   @default(false) // khÃ¡ch Ä‘á»“ng Ã½ háº¹n
  needs_callback    Boolean   @default(false) // khÃ¡ch yÃªu cáº§u gá»i láº¡i
  is_urgent         Boolean   @default(false) // cáº§n há»— trá»£ ngay
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  messages      Message[]
  analysis      ConversationAnalysis?
  bot_sessions  BotSession[]
  contact_logs  ContactLog[]
  analysis_runs AnalysisRun[]

  @@unique([channel, external_conv_id])
  @@map("conversations")
}

// â”€â”€â”€ Messages â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Message {
  id              String    @id @default(uuid())
  conversation_id String
  direction       String // in | out
  sender_type     String // customer | bot | sales
  sender_id       String? // sales user_id náº¿u sender_type = sales
  content         String    @db.Text
  msg_type        String    @default("text") // text | image | file | sticker
  external_msg_id String? // ID tá»« Zalo/Meta (Ä‘á»ƒ dedup)
  is_read         Boolean   @default(false)
  // NgÆ°á»i gá»­i hiá»ƒn thá»‹ â€” ai gá»­i tin nÃ y
  // VÃ­ dá»¥: "Nguyá»…n Sales", "Chatbot", "Tráº£ lá»i trÃªn Zalo", "Tráº£ lá»i trÃªn Messenger", "Tráº£ lá»i trÃªn Telegram"
  sender_label    String?
  sender_username String? // username cá»§a sales náº¿u sender_type=sales
  metadata        Json?
  // Feedback tá»« sales
  feedback        String? // liked | disliked
  feedback_by     String? // user_id
  feedback_at     DateTime?
