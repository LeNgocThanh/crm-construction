// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ Users â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password_hash String
  full_name     String?
  email         String?  @unique
  phone         String?
  avatar_url    String?
  employee_code String?
  job_title     String?
  role          String   @default("sales") // admin | manager | sales
  is_active     Boolean  @default(true)
  last_login_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  contact_logs                         ContactLog[]
  confirmedProjects                    ConstructionProject[]        @relation("ProjectConfirmer")
  ragEntries                           RagEntry[]
  assigned_customers                   Customer[]                   @relation("CustomerAssignee")
  timeline_events                      CustomerTimeline[]           @relation("TimelineCreator")
  care_activities                      CustomerCareActivity[]       @relation("CareActivityCreator")
  owned_care_activities                CustomerCareActivity[]       @relation("CareActivityOwner")
  completed_care_activities            CustomerCareActivity[]       @relation("CareActivityCompleter")
  created_requirement_snapshots        ProjectRequirementSnapshot[] @relation("RequirementSnapshotCreator")
  approved_requirement_snapshots       ProjectRequirementSnapshot[] @relation("RequirementSnapshotApprover")
  estimate_dispatches                  CustomerEstimateDispatch[]   @relation("EstimateDispatchSender")
  group_memberships                    UserGroupMembership[]
  account_type_memberships             UserAccountTypeMembership[]
  role_memberships                     UserRoleMembership[]
  work_suggestion_recipients           WorkSuggestionRecipient[]
  notifications                        UserNotification[]
  action_timeline_events               ActionTimelineEvent[]
  project_timeline_events              ProjectTimelineEvent[]
  held_assets                          Asset[]                      @relation("AssetCurrentHolder")
  asset_assignments                    AssetAssignment[]            @relation("AssetAssignedUser")
  asset_assigned_by                    AssetAssignment[]            @relation("AssetAssignedBy")
  asset_lifecycle_events               AssetLifecycleEvent[]
  uploaded_project_documents           ProjectDocument[]            @relation("ProjectDocumentUploader")
  created_project_milestones           ProjectMilestone[]           @relation("ProjectMilestoneCreator")
  created_project_payment_plans        ProjectPaymentPlan[]         @relation("ProjectPaymentPlanCreator")
  created_project_payments             ProjectPayment[]             @relation("ProjectPaymentCreator")
  created_project_resource_plans       ProjectResourcePlan[]        @relation("ProjectResourcePlanCreator")
  created_project_resource_items       ProjectResourcePlanItem[]    @relation("ProjectResourcePlanItemCreator")
  created_project_diary_entries        ProjectDiaryEntry[]          @relation("ProjectDiaryEntryCreator")
  reported_project_site_issues         ProjectSiteIssue[]           @relation("ProjectSiteIssueReporter")
  assigned_project_site_issues         ProjectSiteIssue[]           @relation("ProjectSiteIssueAssignee")
  verified_project_site_issues         ProjectSiteIssue[]           @relation("ProjectSiteIssueVerifier")
  cancelled_project_site_issues        ProjectSiteIssue[]           @relation("ProjectSiteIssueCanceller")
  project_site_issue_events            ProjectSiteIssueEvent[]      @relation("ProjectSiteIssueEventActor")
  created_project_cashflow_snapshots   ProjectCashflowSnapshot[]    @relation("ProjectCashflowSnapshotCreator")
  uploaded_files                       FileRecord[]                 @relation("FileRecordUploader")
  created_project_direct_purchases     ProjectDirectPurchase[]      @relation("ProjectDirectPurchaseCreator")
  confirmed_project_direct_purchases   ProjectDirectPurchase[]      @relation("ProjectDirectPurchaseConfirmer")
  project_material_ledger_entries      ProjectMaterialLedger[]      @relation("ProjectMaterialLedgerCreator")
  created_project_material_allocations ProjectMaterialAllocation[]  @relation("ProjectMaterialAllocationCreator")
  created_labor_trades                 LaborTrade[]                 @relation("LaborTradeCreator")
  created_labor_crews                  LaborCrew[]                  @relation("LaborCrewCreator")
  created_labor_skill_levels           LaborSkillLevel[]            @relation("LaborSkillLevelCreator")
  created_labor_workers                LaborWorker[]                @relation("LaborWorkerCreator")
  created_labor_engagements            ProjectLaborEngagement[]     @relation("LaborProjectEngagementCreator")
  created_labor_attendances            ProjectLaborAttendance[]     @relation("ProjectLaborAttendanceCreator")
  confirmed_labor_attendances          ProjectLaborAttendance[]     @relation("ProjectLaborAttendanceConfirmer")
  created_labor_rosters                ProjectLaborRoster[]         @relation("ProjectLaborRosterCreator")
  created_labor_payment_batches        ProjectLaborPaymentBatch[]   @relation("ProjectLaborPaymentBatchCreator")
  approved_labor_payment_batches       ProjectLaborPaymentBatch[]   @relation("ProjectLaborPaymentBatchApprover")
  paid_labor_payment_batches           ProjectLaborPaymentBatch[]   @relation("ProjectLaborPaymentBatchPayer")
  cancelled_labor_payment_batches      ProjectLaborPaymentBatch[]   @relation("ProjectLaborPaymentBatchCanceller")
  created_labor_payments               ProjectLaborPayment[]        @relation("ProjectLaborPaymentCreator")
  owned_projects                       ConstructionProject[]        @relation("ProjectOwner")
  default_owned_projects               ConstructionProject[]        @relation("ProjectDefaultOwner")
  resource_access_grants               ResourceAccessGrant[]        @relation("ResourceAccessGrantUser")
  granted_resource_access_grants       ResourceAccessGrant[]        @relation("ResourceAccessGrantGranter")

  @@map("users")
}

model Group {
  id          String   @id @default(uuid())
  group_key   String   @unique
  group_name  String
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  memberships UserGroupMembership[]

  @@index([is_active, group_name])
  @@map("groups")
}

model AccountType {
  id                String                      @id @default(uuid())
  account_type_key  String                      @unique
  account_type_name String
  description       String?                     @db.Text
  is_active         Boolean                     @default(true)
  created_at        DateTime                    @default(now())
  updated_at        DateTime                    @updatedAt

  memberships       UserAccountTypeMembership[]

  @@index([is_active, account_type_name])
  @@map("account_types")
}

model UserGroupMembership {
  id            String   @id @default(uuid())
  user_id       String
  group_id      String
  is_primary    Boolean  @default(false)
  role_in_group String? // leader | member | support
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([user_id, group_id])
  @@index([group_id, is_primary])
  @@index([user_id, is_primary])
  @@map("user_group_memberships")
}

model UserAccountTypeMembership {
  id              String   @id @default(uuid())
  user_id         String
  account_type_id String
  is_primary      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account_type AccountType @relation(fields: [account_type_id], references: [id], onDelete: Cascade)

  @@unique([user_id, account_type_id])
  @@index([account_type_id, is_primary])
  @@index([user_id, is_primary])
  @@map("user_account_type_memberships")
}

model AccessModule {
  id          String   @id @default(uuid())
  module_key  String   @unique
  module_name String
  description String?  @db.Text
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  resources   AccessResource[]
  permissions AccessPermission[]

  @@index([is_active, sort_order])
  @@map("access_modules")
}

model AccessResource {
  id            String   @id @default(uuid())
  resource_key  String   @unique
  resource_name String
  module_id     String
  description   String?  @db.Text
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  module      AccessModule      @relation(fields: [module_id], references: [id], onDelete: Cascade)
  permissions AccessPermission[]

  @@index([module_id, is_active, sort_order])
  @@map("access_resources")
}

model AccessPermission {
  id              String   @id @default(uuid())
  permission_key  String   @unique
  permission_name String
  module_id       String
  resource_id     String?
  action_key      String
  description     String?  @db.Text
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  module           AccessModule             @relation(fields: [module_id], references: [id], onDelete: Cascade)
  resource         AccessResource?          @relation(fields: [resource_id], references: [id], onDelete: SetNull)
  role_permissions AccessRolePermission[]

  @@index([module_id, is_active, sort_order])
  @@index([resource_id, is_active, sort_order])
  @@index([action_key, is_active])
  @@map("access_permissions")
}

model AccessRole {
  id               String   @id @default(uuid())
  role_key         String   @unique
  role_name        String
  description      String?  @db.Text
  is_system        Boolean  @default(true)
  is_active        Boolean  @default(true)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  role_permissions AccessRolePermission[]
  user_memberships UserRoleMembership[]

  @@index([is_active, sort_order])
  @@map("access_roles")
}

model AccessRolePermission {
  id            String   @id @default(uuid())
  role_id       String
  permission_id String
  created_at    DateTime @default(now())

  role       AccessRole       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission AccessPermission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([permission_id])
  @@map("access_role_permissions")
}

model UserRoleMembership {
  id         String   @id @default(uuid())
  user_id    String
  role_id    String
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role AccessRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([role_id, is_primary])
  @@index([user_id, is_primary])
  @@map("user_role_memberships")
}

model ResourceAccessGrant {
  id            String   @id @default(uuid())
  resource_type String
  resource_id   String
  user_id       String
  access_level  String? // viewer | editor | approver | manager
  can_read      Boolean  @default(false)
  can_write     Boolean  @default(false)
  can_approve   Boolean  @default(false)
  can_manage    Boolean  @default(false)
  granted_by    String?
  granted_at    DateTime @default(now())
  expires_at    DateTime?
  is_active     Boolean  @default(true)
  note          String?  @db.Text
  metadata_json Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user    User  @relation("ResourceAccessGrantUser", fields: [user_id], references: [id], onDelete: Cascade)
  granter User? @relation("ResourceAccessGrantGranter", fields: [granted_by], references: [id], onDelete: SetNull)

  @@unique([resource_type, resource_id, user_id])
  @@index([user_id, is_active])
  @@index([resource_type, resource_id, is_active])
  @@index([granted_by, granted_at])
  @@map("resource_access_grants")
}

model Organization {
  id          String   @id @default(uuid())
  parent_id   String?
  org_key     String   @unique
  org_name    String
  org_type    String?
  region_code String?
  address     String?
  legal_name  String?
  tax_code    String?
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent      Organization?  @relation("OrganizationHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children    Organization[] @relation("OrganizationHierarchy")
  departments Department[]

  @@index([is_active, org_name])
  @@index([parent_id])
  @@index([region_code, is_active])
  @@map("organizations")
}

model Department {
  id              String   @id @default(uuid())
  organization_id String
  parent_id       String?
  dept_key        String
  dept_name       String
  description     String?  @db.Text
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentHierarchy")

  @@unique([organization_id, dept_key])
  @@index([organization_id, is_active, sort_order])
  @@index([parent_id])
  @@map("departments")
}

// â”€â”€â”€ Customers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
