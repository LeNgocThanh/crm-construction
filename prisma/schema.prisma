  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("conversation_analyses")
}

// â”€â”€â”€ Bot Sessions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Track tá»«ng láº§n bot Ä‘Æ°á»£c kÃ­ch hoáº¡t/táº¯t trong 1 conversation
model BotSession {
