APP_PORT=5555
DATABASE_URL=postgresql://crm_user:change_me@your-postgres-host:5432/crm_construction?schema=public

DB_PROVIDER=prisma
STORAGE_PROVIDER=local
AI_PROVIDER=ollama

NEXTAUTH_SECRET=change-this-to-a-random-string-at-least-32-chars
NEXTAUTH_URL=https://your-domain.example

UPLOAD_DIR=./public/uploads
UPLOAD_URL_BASE=https://your-domain.example/uploads

BOT_MOCK_MODE=true

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_MODEL_LARGE=gemma3:12b
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_URL=http://host.docker.internal:6333
QDRANT_COLLECTION=crm_rag

GROQ_API_KEY=
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
ZALO_OA_ACCESS_TOKEN=
ZALO_APP_SECRET=
